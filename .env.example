# Postgres local (dev) — DIRECT_URL = même URI que DATABASE_URL
DATABASE_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"
DIRECT_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"

# Postgres Supabase (prod) — Dashboard → Connect
# Pooler session (port 5432, requis pour les transactions Prisma).
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# DATABASE_URL : même URI session.

AUTH_SECRET="change-me-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Comptes créés par `npx prisma db seed` — ne jamais committer les vrais mots de passe
SEED_ADMIN_EMAIL="admin@nerabeaute.cm"
SEED_ADMIN_PASSWORD="ChangeMeNow!"
SEED_CASHIER_EMAIL="caisse@nerabeaute.cm"
SEED_CASHIER_PASSWORD="ChangeMeNow!"
SEED_STOCK_EMAIL="stock@nerabeaute.cm"
SEED_STOCK_PASSWORD="ChangeMeNow!"
SEED_OPS_EMAIL="admin.ops@nerabeaute.cm"
SEED_OPS_PASSWORD="ChangeMeNow!"
SEED_MANAGER_EMAIL="manager@nerabeaute.cm"
SEED_MANAGER_PASSWORD="ChangeMeNow!"
SEED_CUSTOMER_EMAIL="marie.client@example.com"
SEED_CUSTOMER_PASSWORD="ChangeMeNow!"

# Cron Vercel (libération stock commandes impayées). Vercel envoie Authorization: Bearer $CRON_SECRET
CRON_SECRET="change-me-cron-secret"

# Supabase (ne jamais committer les vraies clés)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-jwt"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-jwt"
