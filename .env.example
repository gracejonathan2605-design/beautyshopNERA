# Postgres local (dev) — DIRECT_URL = même URI que DATABASE_URL
DATABASE_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"
DIRECT_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"

# Postgres Supabase (prod) — Dashboard → Connect
# DATABASE_URL = pooler transaction (port 6543). Le mode session (port 5432) plafonne à 15 clients
# et fait échouer le panier (EMAXCONNSESSION). Le code bascule aussi un pooler :5432 vers :6543.
# DIRECT_URL = hôte direct db.[PROJECT_REF].supabase.co:5432 (migrations Prisma uniquement).
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

AUTH_SECRET="change-me-with-a-long-random-string"
# Canonical public : https://www.nerabeaute237.com (forcé automatiquement en production Vercel)
APP_URL="http://localhost:3000"
# Google Search Console — fichier HTML déjà dans public/google34941cdf4c4a8f61.html
# Optionnel : code de la balise meta (méthode HTML tag), sans inventer
# GOOGLE_SITE_VERIFICATION=""
# Fiche Google Business Profile — URL réelle uniquement. Ne pas inventer d’horaires.
# GOOGLE_BUSINESS_PROFILE_URL=""

