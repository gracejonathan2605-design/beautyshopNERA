# Postgres local (dev) — DIRECT_URL = même URI que DATABASE_URL
DATABASE_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"
DIRECT_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"

# Postgres Supabase (prod) — Dashboard → Connect
# Ce projet : pooler aws-1-eu-west-3 (session 5432 — requis pour les transactions Prisma).
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require"
# DATABASE_URL : même URI session (les ventes/stock utilisent des transactions interactives).

AUTH_SECRET="change-me-with-a-long-random-string"
APP_URL="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@nerabeaute.cm"
SEED_ADMIN_PASSWORD="ChangeMeNow!"
SEED_CASHIER_EMAIL="caisse@nerabeaute.cm"
SEED_CASHIER_PASSWORD="ChangeMeNow!"

# Supabase (ne jamais committer les vraies clés)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-jwt"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="your-service-role-jwt"
