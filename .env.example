# Postgres local (dev) — DIRECT_URL = même URI que DATABASE_URL
DATABASE_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"
DIRECT_URL="postgresql://nera:nera_dev_local@127.0.0.1:5432/nera_beaute?schema=public"

# Postgres Supabase (prod) — Dashboard → Connect
# Pooler session (port 5432, requis pour les transactions Prisma).
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
# DATABASE_URL : même URI session.

AUTH_SECRET="change-me-with-a-long-random-string"
# Canonical public : https://www.nerabeaute237.com (forcé automatiquement en production Vercel)
APP_URL="http://localhost:3000"
# Google Search Console — coller uniquement le code de la balise HTML (sans inventer)
# GOOGLE_SITE_VERIFICATION=""
# Fiche Google Business Profile — URL réelle uniquement. Ne pas inventer d’horaires.
# GOOGLE_BUSINESS_PROFILE_URL=""

# Comptes créés par `npx prisma db seed` — ne jamais committer les vrais mots de passe
