SEED_CUSTOMER_PASSWORD="ChangeMeNow!"

# Orange Money production. Ne jamais committer les vraies valeurs.
# Hôte seul : https://api-s1.orange.cm (API locale) ou https://omapi.ynote.africa (Paynote).
# Un chemin /omcoreapis, /token ou /webpayment est ignoré.
# ORANGE_MONEY_API_URL="https://api-s1.orange.cm"
# ORANGE_MONEY_USERNAME=""
# ORANGE_MONEY_PASSWORD=""
# ORANGE_MONEY_AUTH_TOKEN=""
# ORANGE_MONEY_CHANNEL_MSISDN=""
# ORANGE_MONEY_PIN=""
# Paynote (ynote.africa) : l’encaissement automatique part en PaiementMethod OM_CMR.
# AUTH_TOKEN sert de customerkey et PASSWORD de customersecret si les clés dédiées sont vides.
# ORANGE_MONEY_CUSTOMER_KEY=""
# ORANGE_MONEY_CUSTOMER_SECRET=""

# Cron Vercel (libération stock commandes impayées). Vercel envoie Authorization: Bearer $CRON_SECRET
CRON_SECRET="change-me-cron-secret"

# Alerte WhatsApp équipe à chaque commande site validée (nom, téléphone, articles).
# CallMeBot ne fournit souvent aucune clé au Cameroun — préférer Green API.
# Console : https://console.green-api.com — scanner le QR avec le WhatsApp boutique, puis :
ORDER_WHATSAPP_TO="237676935195"
GREEN_API_ID=""
GREEN_API_TOKEN=""
GREEN_API_URL=""
# Optionnel : webhook Make / n8n (POST JSON)
# ORDER_NOTIFY_WEBHOOK=""
# Optionnel : CallMeBot seulement si une apikey a réellement été reçue
# CALLMEBOT_APIKEY=""
# Optionnel : WhatsApp Cloud API Meta
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

